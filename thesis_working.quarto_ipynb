{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Fairness Drift in Mortgage Lending\"\n",
        "subtitle: Comparing Minority-Owned and Non-Minority-Owned Banks, Savings Associations, and Credit Unions in Denial and Pricing Outcomes\"\n",
        "author: \n",
        "  - name: \"Amy Esplain\"\n",
        "    affiliations:\n",
        "      - name: \"University of Arizona\"\n",
        "date: \"Spring 2026\"\n",
        "\n",
        "format:\n",
        "  html:\n",
        "    number-sections: true\n",
        "    toc: true\n",
        "    toc-depth: 4\n",
        "    code-tools: true\n",
        "    embed-resources: true\n",
        "    grid:\n",
        "      margin-width: \"0\"\n",
        "      body-width: \"1000px\"\n",
        "    theme: cosmo\n",
        "    css: paper.css\n",
        "    anchor-sections: true\n",
        "    code-overflow: wrap\n",
        "    smooth-scroll: false\n",
        "\n",
        "  pdf:\n",
        "    documentclass: article\n",
        "    number-sections: true\n",
        "    indent: true\n",
        "    geometry: margin=1.25in\n",
        "    include-in-header:\n",
        "      text: |\n",
        "        \\usepackage{fvextra}\n",
        "        \\usepackage{etoolbox}\n",
        "        \\makeatletter\n",
        "        \\pretocmd{\\@verbatim}{\\small}{}{}\n",
        "        \\makeatother\n",
        "        \\fvset{\n",
        "          breaklines=true,\n",
        "          breakanywhere=true,\n",
        "          breaksymbolleft={}\n",
        "        }\n",
        "\n",
        "editor: visual\n",
        "execute:\n",
        "  warning: false\n",
        "\n",
        "jupyter: python3\n",
        "---\n",
        "\n",
        "### Store Files in DuckDB"
      ],
      "id": "9f7e8b5d"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "# Import packages\n",
        "import pandas as pd\n",
        "import os\n",
        "import duckdb\n",
        "\n",
        "# Combine HMDA files across 2022-2024\n",
        "\n",
        "FILES = [\n",
        "    \"raw_data/raw_data/2022_combined_mlar_header.txt\",\n",
        "    \"raw_data/raw_data/2023_combined_mlar_header.txt\",\n",
        "    \"raw_data/raw_data/2024_combined_mlar_header.txt\",\n",
        "]\n",
        "\n",
        "# Read LEIs and Low Income Designation from Final_CU_List.xlsx\n",
        "cu_list = pd.read_excel(\"Final_CU_List.xlsx\")\n",
        "cu_data = cu_list[['LEI', 'Low Income Designation']].dropna(subset=['LEI']).drop_duplicates(subset=['LEI'])\n",
        "print(f\"Loaded {len(cu_data)} unique LEIs with Low Income Designation from Final_CU_List.xlsx\")\n",
        "\n",
        "lei_col = \"lei\"  # <-- change if your column header is different\n",
        "\n",
        "con = duckdb.connect(\"hmda.duckdb\")\n",
        "\n",
        "# Temp table with LEI and Low Income Designation\n",
        "con.execute(\"CREATE TEMP TABLE target_lei(lei VARCHAR, low_income_designation VARCHAR)\")\n",
        "cu_tuples = [(row['LEI'], row['Low Income Designation']) for _, row in cu_data.iterrows()]\n",
        "con.executemany(\"INSERT INTO target_lei VALUES (?, ?)\", cu_tuples)\n",
        "\n",
        "files_sql = \", \".join([f\"'{f}'\" for f in FILES])\n",
        "\n",
        "con.execute(f\"\"\"\n",
        "COPY (\n",
        "  SELECT h.*, t.low_income_designation\n",
        "  FROM read_csv_auto([{files_sql}], delim='|', header=true, union_by_name=true, files_to_sniff=-1) h\n",
        "  INNER JOIN target_lei t\n",
        "    ON h.{lei_col} = t.lei\n",
        ") TO 'hmda_filtered_2022_2024.parquet' (FORMAT PARQUET);\n",
        "\"\"\")\n"
      ],
      "id": "72587cd4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Filter the data"
      ],
      "id": "dce8cd5c"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "\n",
        "\n",
        "# Filter the data to focus on conventional, owner-occupied, first-lien loans for 1-4 family properties for home purchases\n",
        "\n",
        "con.execute(\"\"\"\n",
        "COPY (\n",
        "  SELECT *\n",
        "  FROM 'hmda_filtered_2022_2024.parquet'\n",
        "  WHERE loan_type = 1 -- First-lien\n",
        "    AND occupancy_type = 1 -- Owner-occupied\n",
        "    AND lien_status = 1 -- Conventional loans\n",
        "    AND total_units IN ('1', '2', '3', '4') -- 1-4 family properties\n",
        "    AND loan_purpose = 1 -- Home purchase \n",
        ") TO 'hmda_filtered_2022_2024_filtered.parquet' (FORMAT PARQUET);\n",
        "\"\"\")"
      ],
      "id": "b44b89b5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### List the columns name, data types, null counts from FILTER data"
      ],
      "id": "a3fefebc"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "# Create connection to analyze filtered data\n",
        "import duckdb\n",
        "import pandas as pd\n",
        "\n",
        "con_filtered = duckdb.connect()\n",
        "\n",
        "# Get column information from the filtered dataset\n",
        "\n",
        "# Get basic column info (name, type)\n",
        "columns_info = con_filtered.execute(\"DESCRIBE SELECT * FROM 'hmda_filtered_2022_2024_filtered.parquet' LIMIT 0\").fetchall()\n",
        "\n",
        "# Get row count for calculating null percentages\n",
        "total_rows = con_filtered.execute(\"SELECT COUNT(*) FROM 'hmda_filtered_2022_2024_filtered.parquet'\").fetchone()[0]\n",
        "\n",
        "print(f\"Total records in filtered dataset: {total_rows:,}\")\n",
        "print(\"\\nColumn Details:\")\n",
        "print(f\"{'#':<3} {'Column Name':<35} {'Data Type':<12} {'Null Count':<12} {'Null %':<8}\")\n",
        "\n",
        "# Analyze each column for null counts\n",
        "for i, column_info in enumerate(columns_info, 1):\n",
        "    col_name, col_type = column_info[0], column_info[1]  # Get first two values safely\n",
        "    \n",
        "    # Count nulls and common HMDA missing value indicators\n",
        "    null_query = f\"\"\"\n",
        "    SELECT \n",
        "        COUNT(*) as total,\n",
        "        COUNT(CASE \n",
        "            WHEN {col_name} IS NULL \n",
        "            OR (CASE WHEN TRY_CAST({col_name} AS VARCHAR) IS NOT NULL \n",
        "                THEN TRY_CAST({col_name} AS VARCHAR) IN ('', 'NA', 'Exempt', 'Not applicable', 'Not provided')\n",
        "                ELSE FALSE END)\n",
        "            THEN 1 END) as null_count\n",
        "    FROM 'hmda_filtered_2022_2024_filtered.parquet'\n",
        "    \"\"\"\n",
        "    \n",
        "    try:\n",
        "        result = con_filtered.execute(null_query).fetchone()\n",
        "        total, null_count = result\n",
        "        null_pct = (null_count / total * 100) if total > 0 else 0\n",
        "        \n",
        "        print(f\"{i:<3} {col_name:<35} {col_type:<12} {null_count:<12,} {null_pct:<7.1f}%\")\n",
        "        \n",
        "    except Exception as e:\n",
        "        print(f\"{i:<3} {col_name:<35} {col_type:<12} {'ERROR':<12} {'N/A':<8}\")\n",
        "\n",
        "print(f\"\\nTotal columns: {len(columns_info)}\")"
      ],
      "id": "8d947c19",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Feature Engineering and Analysis\n",
        "\n",
        "### Feature Engineering"
      ],
      "id": "e5498da6"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "\n",
        "\n",
        "# Summarize columns by low income designation, denial rates (not count), pricing outcomes for each year and between low income designation\n",
        "summary_query = \"\"\"\n",
        "SELECT\n",
        "    low_income_designation,\n",
        "    activity_year,\n",
        "    COUNT(*) AS total_applications,\n",
        "    SUM(CASE WHEN action_taken = 3 THEN 1 ELSE 0 END) * 100.0 / COUNT(*) AS denial_rate,\n",
        "    AVG(CASE WHEN action_taken IN (1, 2) THEN 1 ELSE 0 END) * 100.0 AS approval_rate,\n",
        "    AVG(CASE WHEN action_taken IN (1, 2) THEN CAST(loan_amount AS FLOAT) END) AS avg_loan_amount\n",
        "FROM 'hmda_filtered_2022_2024_filtered.parquet'\n",
        "-- Grouping by low income designation and activity_year for comparison\n",
        "GROUP BY low_income_designation, activity_year\n",
        "ORDER BY low_income_designation, activity_year\n",
        "\"\"\"\n",
        "\n",
        "summary_df = con_filtered.execute(summary_query).fetchdf()\n",
        "print(summary_df) "
      ],
      "id": "8c61cce5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Denial Rates & Loan Amount Distributions by Low Income Designation and Year"
      ],
      "id": "8b369b1e"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "### Denial Rates\n",
        "\n",
        "# Plot denial rates by low income designation and year\n",
        "\n",
        "sns.set(style=\"whitegrid\")\n",
        "plt.figure(figsize=(10,5))\n",
        "sns.barplot(x=\"activity_year\", y=\"denial_rate\", hue=\"low_income_designation\", data=summary_df)\n",
        "plt.title(\"Denial Rates by Low Income Designation and Year\")\n",
        "plt.ylabel(\"Denial Rate (%)\")\n",
        "plt.xlabel(\"Year\")\n",
        "plt.legend(title=\"Low Income Designation\")\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# Distribution of Loan Amounts by Low Income Designation and Year using box plots and histograms\n",
        "\n",
        "# Get individual loan amounts for approved loans (not averages)\n",
        "loan_distribution_query = \"\"\"\n",
        "SELECT\n",
        "    low_income_designation,\n",
        "    activity_year,\n",
        "    CAST(loan_amount AS FLOAT) AS loan_amount\n",
        "FROM 'hmda_filtered_2022_2024_filtered.parquet'\n",
        "WHERE action_taken IN (1, 2) -- Only approved/originated loans\n",
        "  AND loan_amount IS NOT NULL\n",
        "  AND CAST(loan_amount AS FLOAT) > 0\n",
        "ORDER BY low_income_designation, activity_year\n",
        "\"\"\"\n",
        "\n",
        "# Execute the query to create loan_df\n",
        "loan_df = con_filtered.execute(loan_distribution_query).fetchdf()\n",
        "print(f\"Loan distribution data shape: {loan_df.shape}\")\n",
        "print(loan_df.head())\n",
        "\n",
        "# Histogram plot showing loan amount distributions by low income designation and year for approved loans\n",
        "\n",
        "# Create histogram with subplots for each year\n",
        "plt.figure(figsize=(15,9))\n",
        "years = sorted(loan_df['activity_year'].unique())\n",
        "for i, year in enumerate(years):\n",
        "    plt.subplot(2, 2, i+1)\n",
        "    year_data = loan_df[loan_df['activity_year'] == year]\n",
        "    \n",
        "    for designation in sorted(year_data['low_income_designation'].unique()):\n",
        "        designation_data = year_data[year_data['low_income_designation'] == designation]\n",
        "        plt.hist(designation_data['loan_amount'], bins=30, alpha=0.7, \n",
        "                label=f'{designation}', density=True, edgecolor='black', linewidth=0.5)\n",
        "    \n",
        "    plt.title(f'Loan Amount Distribution - {year}')\n",
        "    plt.xlabel('Loan Amount ($)')\n",
        "    plt.ylabel('Density')\n",
        "    plt.legend(title='Low Income Designation')\n",
        "    plt.ticklabel_format(style='plain', axis='x')\n",
        "    plt.xlim(0, 2000000)\n",
        "    plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# Box plot showing loan amount distribution by low income designation and year\n",
        "plt.figure(figsize=(15,9))\n",
        "sns.boxplot(x=\"activity_year\", y=\"loan_amount\", hue=\"low_income_designation\", data=loan_df)\n",
        "plt.title(\"Distribution of Loan Amounts by Low Income Designation and Year\")\n",
        "plt.ylabel(\"Loan Amount ($)\")\n",
        "plt.xlabel(\"Year\")\n",
        "plt.legend(title=\"Low Income Designation\")\n",
        "plt.ticklabel_format(style='plain', axis='y')\n",
        "plt.ylim(0, 2000000)\n",
        "plt.xticks(rotation=0)\n",
        "plt.show()\n",
        "\n",
        "# Histogram showing loan amount distributions\n",
        "plt.figure(figsize=(15,9))\n",
        "for i, year in enumerate(sorted(loan_df['activity_year'].unique())):\n",
        "    plt.subplot(2, 2, i+1)\n",
        "    year_data = loan_df[loan_df['activity_year'] == year]\n",
        "    for designation in year_data['low_income_designation'].unique():\n",
        "        designation_data = year_data[year_data['low_income_designation'] == designation]\n",
        "        plt.hist(designation_data['loan_amount'], bins=50, alpha=0.6, \n",
        "                label=designation, density=True)\n",
        "    plt.title(f'Loan Amount Distribution - {year}')\n",
        "    plt.xlabel('Loan Amount ($)')\n",
        "    plt.ylabel('Density')\n",
        "    plt.legend()\n",
        "    plt.ticklabel_format(style='plain', axis='x')\n",
        "    plt.xlim(0, 2000000)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "964a0c6c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Interest Rate Spread Distributions by Low Income Designation and Year"
      ],
      "id": "c19dd5c2"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "# Pricing (interest rates) analysis by low income designation and year for approved loans\n",
        "pricing_query = \"\"\"\n",
        "SELECT\n",
        "    low_income_designation,\n",
        "    activity_year,\n",
        "    CAST(interest_rate AS FLOAT) AS interest_rate\n",
        "FROM 'hmda_filtered_2022_2024_filtered.parquet'\n",
        "WHERE action_taken IN (1, 2) -- Only approved/originated loans\n",
        "  AND interest_rate IS NOT NULL\n",
        "  AND TRY_CAST(interest_rate AS FLOAT) IS NOT NULL\n",
        "  AND TRY_CAST(interest_rate AS FLOAT) > 0\n",
        "ORDER BY low_income_designation, activity_year\n",
        "\"\"\"\n",
        "pricing_df = con_filtered.execute(pricing_query).fetchdf()\n",
        "print(f\"Pricing data shape: {pricing_df.shape}\")\n",
        "print(pricing_df.head())\n",
        "\n",
        "# Visualize pricing distributions by low income designation and year using box plots\n",
        "plt.figure(figsize=(15,9))\n",
        "sns.boxplot(x=\"activity_year\", y=\"interest_rate\", hue=\"low_income_designation\", data=pricing_df)\n",
        "plt.title(\"Distribution of Interest Rates by Low Income Designation and Year\")\n",
        "plt.ylabel(\"Interest Rate (%)\")\n",
        "plt.xlabel(\"Year\")\n",
        "plt.legend(title=\"Low Income Designation\")\n",
        "plt.ylim(0, 20)\n",
        "plt.xticks(rotation=0)\n",
        "plt.show()  "
      ],
      "id": "5cb635ab",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Applicant Income Distribution"
      ],
      "id": "0ae21b3c"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "# Get applicant income data from filtered dataset\n",
        "income_query = \"\"\"\n",
        "SELECT\n",
        "    low_income_designation,\n",
        "    activity_year,\n",
        "    CASE \n",
        "        WHEN TRY_CAST(income AS FLOAT) IS NOT NULL AND TRY_CAST(income AS FLOAT) > 0 \n",
        "        THEN CAST(income AS FLOAT) \n",
        "        ELSE NULL \n",
        "    END AS applicant_income\n",
        "FROM 'hmda_filtered_2022_2024_filtered.parquet'\n",
        "WHERE income IS NOT NULL\n",
        "\"\"\"\n",
        "\n",
        "income_df = con_filtered.execute(income_query).fetchdf()\n",
        "income_df = income_df.dropna(subset=['applicant_income'])\n",
        "\n",
        "print(f\"\\nApplicant Income Data:\")\n",
        "print(f\"Total records with valid income: {len(income_df):,}\")\n",
        "print(f\"\\nIncome Summary by Low Income Designation:\")\n",
        "print(income_df.groupby('low_income_designation')['applicant_income'].describe())\n",
        "\n",
        "# Side-by-side histograms for income distribution\n",
        "fig, axes = plt.subplots(1, 2, figsize=(16, 7))\n",
        "\n",
        "# Create income bins\n",
        "income_bins = range(0, 401, 20)  # $0 to $400K in $20K increments\n",
        "\n",
        "designations = sorted(income_df['low_income_designation'].unique())\n",
        "colors = ['steelblue', 'coral']\n",
        "titles = ['Non-Low Income Designated Credit Unions', 'Low Income Designated Credit Unions']\n",
        "\n",
        "for idx, designation in enumerate(designations):\n",
        "    designation_data = income_df[income_df['low_income_designation'] == designation]\n",
        "    \n",
        "    axes[idx].hist(designation_data['applicant_income'], bins=income_bins, \n",
        "                   color=colors[idx], alpha=0.7, edgecolor='black', linewidth=0.5)\n",
        "    \n",
        "    axes[idx].set_title(titles[idx], fontsize=13, fontweight='bold')\n",
        "    axes[idx].set_xlabel('Applicant Income ($1000s)', fontsize=11)\n",
        "    axes[idx].set_ylabel('Number of Applicants', fontsize=11)\n",
        "    axes[idx].set_xlim(0, 400)\n",
        "    axes[idx].grid(True, alpha=0.3)\n",
        "    \n",
        "    # Add statistics text\n",
        "    median_val = designation_data['applicant_income'].median()\n",
        "    mean_val = designation_data['applicant_income'].mean()\n",
        "    count_val = len(designation_data)\n",
        "    \n",
        "    axes[idx].axvline(median_val, color='red', linestyle='--', linewidth=2, alpha=0.8)\n",
        "    axes[idx].text(0.7, 0.95, f'Count: {count_val:,}', transform=axes[idx].transAxes, \n",
        "                   verticalalignment='top', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n",
        "    axes[idx].text(0.7, 0.85, f'Median: ${median_val:.0f}K', transform=axes[idx].transAxes, \n",
        "                   verticalalignment='top', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n",
        "    axes[idx].text(0.7, 0.75, f'Mean: ${mean_val:.0f}K', transform=axes[idx].transAxes, \n",
        "                   verticalalignment='top', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n",
        "\n",
        "plt.suptitle('Applicant Income Distribution by Credit Union Type', fontsize=16, fontweight='bold')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Print median and mean values\n",
        "print(\"\\nIncome Statistics by Low Income Designation:\")\n",
        "for designation in sorted(income_df['low_income_designation'].unique()):\n",
        "    designation_data = income_df[income_df['low_income_designation'] == designation]\n",
        "    print(f\"\\n  {designation}:\")\n",
        "    print(f\"    Count: {len(designation_data):,}\")\n",
        "    print(f\"    Mean: ${designation_data['applicant_income'].mean():,.2f}K\")\n",
        "    print(f\"    Median: ${designation_data['applicant_income'].median():,.2f}K\")\n",
        "    print(f\"    25th percentile: ${designation_data['applicant_income'].quantile(0.25):,.2f}K\")\n",
        "    print(f\"    75th percentile: ${designation_data['applicant_income'].quantile(0.75):,.2f}K\")"
      ],
      "id": "51df35b9",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Interest Rates by Income Buckets"
      ],
      "id": "baec5250"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "# Interest rates by income buckets\n",
        "income_rates_query = \"\"\"\n",
        "SELECT\n",
        "    low_income_designation,\n",
        "    CASE \n",
        "        WHEN TRY_CAST(income AS FLOAT) IS NOT NULL AND TRY_CAST(income AS FLOAT) > 0 \n",
        "        THEN CAST(income AS FLOAT) \n",
        "        ELSE NULL \n",
        "    END AS applicant_income,\n",
        "    CASE \n",
        "        WHEN TRY_CAST(interest_rate AS FLOAT) IS NOT NULL AND TRY_CAST(interest_rate AS FLOAT) > 0 \n",
        "        THEN CAST(interest_rate AS FLOAT) \n",
        "        ELSE NULL \n",
        "    END AS interest_rate\n",
        "FROM 'hmda_filtered_2022_2024_filtered.parquet'\n",
        "WHERE action_taken IN (1, 2) -- Only approved loans\n",
        "  AND income IS NOT NULL\n",
        "  AND interest_rate IS NOT NULL\n",
        "\"\"\"\n",
        "\n",
        "income_rates_df = con_filtered.execute(income_rates_query).fetchdf()\n",
        "income_rates_df = income_rates_df.dropna(subset=['applicant_income', 'interest_rate'])\n",
        "\n",
        "# Create income buckets\n",
        "income_rates_df['income_bucket'] = pd.cut(\n",
        "    income_rates_df['applicant_income'], \n",
        "    bins=[0, 50, 75, 100, 150, 200, 300, 400], \n",
        "    labels=['<$50K', '$50K-75K', '$75K-100K', '$100K-150K', '$150K-200K', '$200K-300K', '$300K-400K']\n",
        ")\n",
        "\n",
        "# Filter out extreme interest rates for cleaner visualization\n",
        "income_rates_df = income_rates_df[income_rates_df['interest_rate'] <= 15]\n",
        "\n",
        "print(f\"\\nInterest Rate by Income Bucket Data:\")\n",
        "print(f\"Total approved loans with valid income and rate data: {len(income_rates_df):,}\")\n",
        "\n",
        "# Box plot showing interest rates by income bucket and credit union type\n",
        "plt.figure(figsize=(16, 8))\n",
        "sns.boxplot(x='income_bucket', y='interest_rate', hue='low_income_designation', \n",
        "            data=income_rates_df, palette=['steelblue', 'coral'])\n",
        "plt.title('Interest Rates by Income Bucket and Credit Union Type', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Income Bucket', fontsize=12)\n",
        "plt.ylabel('Interest Rate (%)', fontsize=12)\n",
        "plt.ylim(2, 8)\n",
        "plt.legend(title='Low Income Designation', fontsize=11)\n",
        "plt.xticks(rotation=45)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Average interest rates by income bucket\n",
        "avg_rates = income_rates_df.groupby(['income_bucket', 'low_income_designation'])['interest_rate'].agg(['count', 'mean']).round(3)\n",
        "avg_rates.columns = ['count', 'avg_rate']\n",
        "avg_rates = avg_rates.reset_index()\n",
        "avg_rates = avg_rates[avg_rates['count'] >= 10]  # Minimum sample size\n",
        "\n",
        "print(\"\\nAverage Interest Rates by Income Bucket:\")\n",
        "print(avg_rates)\n",
        "\n",
        "# Bar plot of average interest rates\n",
        "plt.figure(figsize=(14, 7))\n",
        "sns.barplot(x='income_bucket', y='avg_rate', hue='low_income_designation', \n",
        "            data=avg_rates, palette=['steelblue', 'coral'])\n",
        "plt.title('Average Interest Rates by Income Bucket and Credit Union Type', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Income Bucket', fontsize=12)\n",
        "plt.ylabel('Average Interest Rate (%)', fontsize=12)\n",
        "plt.ylim(2, 8)\n",
        "plt.legend(title='Low Income Designation', fontsize=11)\n",
        "plt.xticks(rotation=45)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "ac1ebb6e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Similar Loans Analysis: Interest Rate Comparison for Matched Loan Profiles"
      ],
      "id": "5460b358"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "# Get comprehensive loan data for matching analysis\n",
        "similar_loans_query = \"\"\"\n",
        "SELECT\n",
        "    low_income_designation,\n",
        "    CAST(loan_amount AS FLOAT) AS loan_amount,\n",
        "    CASE \n",
        "        WHEN TRY_CAST(interest_rate AS FLOAT) IS NOT NULL AND TRY_CAST(interest_rate AS FLOAT) > 0 \n",
        "        THEN CAST(interest_rate AS FLOAT) \n",
        "        ELSE NULL \n",
        "    END AS interest_rate,\n",
        "    CASE \n",
        "        WHEN TRY_CAST(income AS FLOAT) IS NOT NULL AND TRY_CAST(income AS FLOAT) > 0 \n",
        "        THEN CAST(income AS FLOAT) \n",
        "        ELSE NULL \n",
        "    END AS applicant_income,\n",
        "    debt_to_income_ratio,\n",
        "    derived_race,\n",
        "    CASE \n",
        "        WHEN TRY_CAST(property_value AS FLOAT) IS NOT NULL AND TRY_CAST(property_value AS FLOAT) > 0 \n",
        "        THEN CAST(property_value AS FLOAT) \n",
        "        ELSE NULL \n",
        "    END AS property_value,\n",
        "    combined_loan_to_value_ratio\n",
        "FROM 'hmda_filtered_2022_2024_filtered.parquet'\n",
        "WHERE action_taken IN (1, 2) -- Only approved loans\n",
        "  AND loan_amount IS NOT NULL\n",
        "  AND interest_rate IS NOT NULL\n",
        "  AND income IS NOT NULL\n",
        "  AND derived_race IS NOT NULL\n",
        "\"\"\"\n",
        "\n",
        "loans_df = con_filtered.execute(similar_loans_query).fetchdf()\n",
        "loans_df = loans_df.dropna(subset=['loan_amount', 'interest_rate', 'applicant_income'])\n",
        "\n",
        "# Filter for reasonable interest rate range\n",
        "loans_df = loans_df[loans_df['interest_rate'] <= 12]\n",
        "\n",
        "print(f\"Total approved loans with complete data: {len(loans_df):,}\")\n",
        "\n",
        "# Create matching cohorts based on loan characteristics\n",
        "loans_df['loan_amount_cohort'] = pd.cut(\n",
        "    loans_df['loan_amount'], \n",
        "    bins=[0, 200000, 300000, 400000, 500000, float('inf')], \n",
        "    labels=['<$200K', '$200K-300K', '$300K-400K', '$400K-500K', '>$500K']\n",
        ")\n",
        "\n",
        "loans_df['income_cohort'] = pd.cut(\n",
        "    loans_df['applicant_income'], \n",
        "    bins=[0, 60000, 90000, 120000, 180000, float('inf')], \n",
        "    labels=['<$60K', '$60K-90K', '$90K-120K', '$120K-180K', '>$180K']\n",
        ")\n",
        "\n",
        "# Convert DTI to numeric and create cohorts\n",
        "loans_df['dti_numeric'] = pd.to_numeric(\n",
        "    loans_df['debt_to_income_ratio'].replace(['NA', 'Exempt', 'Not applicable'], None), \n",
        "    errors='coerce'\n",
        ")\n",
        "\n",
        "loans_df['dti_cohort'] = pd.cut(\n",
        "    loans_df['dti_numeric'], \n",
        "    bins=[0, 25, 35, 45, float('inf')], \n",
        "    labels=['<25%', '25%-35%', '35%-45%', '>45%']\n",
        ")\n",
        "\n",
        "# Examine race values and create race cohorts\n",
        "print(\"\\nRace distribution in data:\")\n",
        "print(loans_df['derived_race'].value_counts())\n",
        "\n",
        "# Create race cohorts based on derived race field\n",
        "# Derived race provides standardized categories\n",
        "loans_df['race_cohort'] = loans_df['derived_race'].map({\n",
        "    'American Indian or Alaska Native': 'American Indian/Alaska Native',\n",
        "    'Asian': 'Asian',\n",
        "    'Black or African American': 'Black/African American', \n",
        "    'Native Hawaiian or Other Pacific Islander': 'Native Hawaiian/Pacific Islander',\n",
        "    'White': 'White',\n",
        "    'Race Not Available': 'Not Available',\n",
        "    '2 or more minority races': 'Multiple Minority',\n",
        "    'Joint': 'Joint Application'\n",
        "})\n",
        "\n",
        "# Fill any unmapped values\n",
        "loans_df['race_cohort'] = loans_df['race_cohort'].fillna('Other')\n",
        "print(f\"\\nRace cohort distribution:\")\n",
        "print(loans_df['race_cohort'].value_counts())\n",
        "\n",
        "# Create composite matching cohort including race\n",
        "loans_df['match_cohort'] = (\n",
        "    loans_df['loan_amount_cohort'].astype(str) + ' | ' +\n",
        "    loans_df['income_cohort'].astype(str) + ' | ' +\n",
        "    loans_df['dti_cohort'].astype(str) + ' | ' +\n",
        "    loans_df['race_cohort'].astype(str)\n",
        ")\n",
        "\n",
        "# Find cohorts that exist in both credit union types\n",
        "cohort_counts = loans_df.dropna(subset=['match_cohort']).groupby(['match_cohort', 'low_income_designation']).size().reset_index(name='count')\n",
        "cohort_summary = cohort_counts.pivot(index='match_cohort', columns='low_income_designation', values='count').fillna(0)\n",
        "\n",
        "print(f\"Available columns in cohort_summary: {list(cohort_summary.columns)}\")\n",
        "print(f\"Cohort summary shape: {cohort_summary.shape}\")\n",
        "\n",
        "# The data uses '0' and '1' instead of 'No' and 'Yes'\n",
        "# Check which columns actually exist\n",
        "has_0 = '0' in cohort_summary.columns  # Non-low income designated\n",
        "has_1 = '1' in cohort_summary.columns  # Low income designated\n",
        "\n",
        "if has_0 and has_1:\n",
        "    matched_cohorts = cohort_summary[(cohort_summary['0'] >= 10) & (cohort_summary['1'] >= 10)].index\n",
        "    print(f\"Found cohorts with both designation types\")\n",
        "elif has_0:\n",
        "    print(\"Warning: Only '0' (non-low income designated) found in data\")\n",
        "    matched_cohorts = cohort_summary[cohort_summary['0'] >= 10].index\n",
        "elif has_1:\n",
        "    print(\"Warning: Only '1' (low income designated) found in data\")  \n",
        "    matched_cohorts = cohort_summary[cohort_summary['1'] >= 10].index\n",
        "else:\n",
        "    print(\"Error: No valid low_income_designation values found\")\n",
        "    matched_cohorts = []\n",
        "\n",
        "print(f\"\\nFound {len(matched_cohorts)} cohorts with sufficient data in both credit union types\")\n",
        "\n",
        "# Analyze matched cohorts\n",
        "matched_loans = loans_df[loans_df['match_cohort'].isin(matched_cohorts)].dropna(subset=['match_cohort'])\n",
        "\n",
        "print(f\"\\nMatching Analysis Summary:\")\n",
        "print(f\"- Total unique cohorts identified: {len(loans_df['match_cohort'].unique())}\")\n",
        "print(f\"- Cohorts with both CU types and sufficient data: {len(matched_cohorts)}\")\n",
        "print(f\"- Total individual loans in matched cohorts: {len(matched_loans):,}\")\n",
        "if len(matched_loans) > 0:\n",
        "    print(f\"- Average loans per matched cohort: {len(matched_loans) / len(matched_cohorts):.1f}\")\n",
        "    print(f\"- Breakdown by CU type:\")\n",
        "    cu_breakdown = matched_loans['low_income_designation'].value_counts()\n",
        "    for cu_type, count in cu_breakdown.items():\n",
        "        cu_label = 'Low Income Designated' if cu_type == '1' else 'Non-Low Income Designated'\n",
        "        print(f\"  {cu_label}: {count:,} loans\")\n",
        "    \n",
        "    # Show data count for each individual matched cohort\n",
        "    print(f\"\\nDetailed Breakdown by Individual Matched Cohorts:\")\n",
        "    cohort_details = matched_loans.groupby(['match_cohort', 'low_income_designation']).size().reset_index(name='loan_count')\n",
        "    cohort_summary_detailed = cohort_details.pivot(index='match_cohort', columns='low_income_designation', values='loan_count').fillna(0)\n",
        "    \n",
        "    # Add readable column names and totals\n",
        "    cohort_summary_detailed.columns = ['Non-Low Income CU', 'Low Income CU']\n",
        "    cohort_summary_detailed['Total'] = cohort_summary_detailed['Non-Low Income CU'] + cohort_summary_detailed['Low Income CU']\n",
        "    cohort_summary_detailed = cohort_summary_detailed.sort_values('Total', ascending=False)\n",
        "    \n",
        "    print(cohort_summary_detailed.astype(int))\n",
        "    \n",
        "    print(f\"\\nCohort Statistics:\")\n",
        "    print(f\"- Largest cohort: {cohort_summary_detailed['Total'].max():.0f} loans\")\n",
        "    print(f\"- Smallest cohort: {cohort_summary_detailed['Total'].min():.0f} loans\")\n",
        "    print(f\"- Median cohort size: {cohort_summary_detailed['Total'].median():.0f} loans\")\n",
        "\n",
        "if len(matched_loans) > 0:\n",
        "    # Calculate rate differences by cohort\n",
        "    rate_analysis = matched_loans.groupby(['match_cohort', 'low_income_designation']).agg({\n",
        "        'interest_rate': ['count', 'mean', 'median', 'std'],\n",
        "        'loan_amount': 'mean',\n",
        "        'applicant_income': 'mean',\n",
        "        'dti_numeric': 'mean'\n",
        "    }).round(3)\n",
        "    \n",
        "    rate_analysis.columns = ['count', 'avg_rate', 'median_rate', 'std_rate', 'avg_loan', 'avg_income', 'avg_dti']\n",
        "    rate_analysis = rate_analysis.reset_index()\n",
        "    \n",
        "    # Create side-by-side comparison\n",
        "    rate_pivot = rate_analysis.pivot(index='match_cohort', columns='low_income_designation', values='avg_rate')\n",
        "    if '1' in rate_pivot.columns and '0' in rate_pivot.columns:\n",
        "        rate_pivot['Rate_Difference'] = rate_pivot['1'] - rate_pivot['0']  # Low income CU - Non-low income CU\n",
        "        rate_pivot['Abs_Difference'] = abs(rate_pivot['Rate_Difference'])\n",
        "        \n",
        "        # Add readable column names for display\n",
        "        rate_pivot = rate_pivot.rename(columns={'0': 'Non-Low_Income_CU', '1': 'Low_Income_CU'})\n",
        "        \n",
        "        print(\"\\nInterest Rate Comparison for Similar Loan Profiles:\")\n",
        "        print(\"(Positive difference = Low Income CUs charge higher rates)\")\n",
        "        print(rate_pivot.sort_values('Abs_Difference', ascending=False))\n",
        "        \n",
        "        # Summary statistics\n",
        "        print(f\"\\nSummary of Rate Differences:\")\n",
        "        print(f\"Average difference: {rate_pivot['Rate_Difference'].mean():.3f} percentage points\")\n",
        "        print(f\"Median difference: {rate_pivot['Rate_Difference'].median():.3f} percentage points\")\n",
        "        print(f\"Standard deviation: {rate_pivot['Rate_Difference'].std():.3f} percentage points\")\n",
        "        print(f\"Cohorts where Low Income CUs charge more: {(rate_pivot['Rate_Difference'] > 0).sum()}\")\n",
        "        print(f\"Cohorts where Low Income CUs charge less: {(rate_pivot['Rate_Difference'] < 0).sum()}\")\n",
        "        \n",
        "        # Visualizations\n",
        "        # 1. Rate differences by cohort\n",
        "        rate_diff_df = rate_pivot.reset_index()\n",
        "        top_differences = rate_diff_df.nlargest(10, 'Abs_Difference')\n",
        "        \n",
        "        plt.figure(figsize=(16, 8))\n",
        "        colors = ['red' if x > 0 else 'green' for x in top_differences['Rate_Difference']]\n",
        "        bars = plt.bar(range(len(top_differences)), top_differences['Rate_Difference'], color=colors, alpha=0.7)\n",
        "        plt.title('Interest Rate Differences by Loan Cohort\\n(Top 10 Largest Differences)', fontsize=14, fontweight='bold')\n",
        "        plt.xlabel('Loan Cohort (Loan Amount | Income | DTI | Race)', fontsize=12)\n",
        "        plt.ylabel('Rate Difference (Low Income CU - Non-Low Income CU)', fontsize=12)\n",
        "        plt.xticks(range(len(top_differences)), top_differences['match_cohort'], rotation=45, ha='right')\n",
        "        plt.axhline(y=0, color='black', linestyle='-', alpha=0.5)\n",
        "        plt.grid(True, alpha=0.3)\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n",
        "        \n",
        "        # 3. Statistical significance test\n",
        "        from scipy import stats\n",
        "        import numpy as np\n",
        "        \n",
        "        low_income_rates = matched_loans[matched_loans['low_income_designation'] == '1']['interest_rate']\n",
        "        non_low_income_rates = matched_loans[matched_loans['low_income_designation'] == '0']['interest_rate']\n",
        "        \n",
        "        print(f\"\\n\" + \"=\"*60)\n",
        "        print(\"COMPREHENSIVE STATISTICAL ANALYSIS\")\n",
        "        print(\"=\"*60)\n",
        "        \n",
        "        # 1. Two-sample t-test (parametric)\n",
        "        t_stat, p_value_ttest = stats.ttest_ind(low_income_rates, non_low_income_rates)\n",
        "        \n",
        "        # 2. Mann-Whitney U test (non-parametric alternative)\n",
        "        u_stat, p_value_mannwhitney = stats.mannwhitneyu(low_income_rates, non_low_income_rates, alternative='two-sided')\n",
        "        \n",
        "        # 3. Effect size (Cohen's d)\n",
        "        pooled_std = np.sqrt(((len(low_income_rates) - 1) * low_income_rates.var() + \n",
        "                             (len(non_low_income_rates) - 1) * non_low_income_rates.var()) / \n",
        "                            (len(low_income_rates) + len(non_low_income_rates) - 2))\n",
        "        cohens_d = (low_income_rates.mean() - non_low_income_rates.mean()) / pooled_std\n",
        "        \n",
        "        # 4. Confidence interval for the difference in means\n",
        "        diff_mean = low_income_rates.mean() - non_low_income_rates.mean()\n",
        "        se_diff = np.sqrt(low_income_rates.var()/len(low_income_rates) + \n",
        "                         non_low_income_rates.var()/len(non_low_income_rates))\n",
        "        ci_lower = diff_mean - 1.96 * se_diff\n",
        "        ci_upper = diff_mean + 1.96 * se_diff\n",
        "        \n",
        "        # 5. Levene's test for equal variances\n",
        "        levene_stat, p_value_levene = stats.levene(low_income_rates, non_low_income_rates)\n",
        "        \n",
        "        # 6. Welch's t-test (unequal variances)\n",
        "        welch_stat, p_value_welch = stats.ttest_ind(low_income_rates, non_low_income_rates, equal_var=False)\n",
        "        \n",
        "        print(f\"\\nSample Sizes:\")\n",
        "        print(f\"- Low Income Designated CUs: {len(low_income_rates):,} loans\")\n",
        "        print(f\"- Non-Low Income Designated CUs: {len(non_low_income_rates):,} loans\")\n",
        "        \n",
        "        print(f\"\\nDescriptive Statistics:\")\n",
        "        print(f\"Low Income Designated CUs:\")\n",
        "        print(f\"  Mean: {low_income_rates.mean():.4f}%\")\n",
        "        print(f\"  Median: {low_income_rates.median():.4f}%\")\n",
        "        print(f\"  Std Dev: {low_income_rates.std():.4f}%\")\n",
        "        \n",
        "        print(f\"Non-Low Income Designated CUs:\")\n",
        "        print(f\"  Mean: {non_low_income_rates.mean():.4f}%\")\n",
        "        print(f\"  Median: {non_low_income_rates.median():.4f}%\")\n",
        "        print(f\"  Std Dev: {non_low_income_rates.std():.4f}%\")\n",
        "        \n",
        "        print(f\"\\nDifference in Means: {diff_mean:+.4f} percentage points\")\n",
        "        print(f\"95% Confidence Interval: [{ci_lower:+.4f}, {ci_upper:+.4f}]\")\n",
        "        \n",
        "        print(f\"\\nStatistical Tests:\")\n",
        "        print(f\"1. Two-Sample T-Test (equal variances assumed):\")\n",
        "        print(f\"   t-statistic: {t_stat:.4f}\")\n",
        "        print(f\"   p-value: {p_value_ttest:.6f}\")\n",
        "        print(f\"   Significant at α=0.05: {'Yes' if p_value_ttest < 0.05 else 'No'}\")\n",
        "        print(f\"   Significant at α=0.01: {'Yes' if p_value_ttest < 0.01 else 'No'}\")\n",
        "        \n",
        "        print(f\"\\n2. Welch's T-Test (unequal variances):\")\n",
        "        print(f\"   t-statistic: {welch_stat:.4f}\")\n",
        "        print(f\"   p-value: {p_value_welch:.6f}\")\n",
        "        print(f\"   Significant at α=0.05: {'Yes' if p_value_welch < 0.05 else 'No'}\")\n",
        "        \n",
        "        print(f\"\\n3. Mann-Whitney U Test (non-parametric):\")\n",
        "        print(f\"   U-statistic: {u_stat:.0f}\")\n",
        "        print(f\"   p-value: {p_value_mannwhitney:.6f}\")\n",
        "        print(f\"   Significant at α=0.05: {'Yes' if p_value_mannwhitney < 0.05 else 'No'}\")\n",
        "        \n",
        "        print(f\"\\n4. Test for Equal Variances (Levene's Test):\")\n",
        "        print(f\"   Levene statistic: {levene_stat:.4f}\")\n",
        "        print(f\"   p-value: {p_value_levene:.6f}\")\n",
        "        print(f\"   Equal variances: {'Yes' if p_value_levene > 0.05 else 'No'}\")\n",
        "        \n",
        "        print(f\"\\nEffect Size:\")\n",
        "        print(f\"Cohen's d: {cohens_d:.4f}\")\n",
        "        if abs(cohens_d) < 0.2:\n",
        "            effect_size = \"Small\"\n",
        "        elif abs(cohens_d) < 0.5:\n",
        "            effect_size = \"Small to Medium\"\n",
        "        elif abs(cohens_d) < 0.8:\n",
        "            effect_size = \"Medium to Large\"\n",
        "        else:\n",
        "            effect_size = \"Large\"\n",
        "        print(f\"Effect Size Interpretation: {effect_size}\")\n",
        "        \n",
        "        print(f\"\\nOverall Conclusion:\")\n",
        "        if p_value_ttest < 0.001:\n",
        "            print(f\"- Highly significant difference (p < 0.001)\")\n",
        "        elif p_value_ttest < 0.01:\n",
        "            print(f\"- Very significant difference (p < 0.01)\")\n",
        "        elif p_value_ttest < 0.05:\n",
        "            print(f\"- Significant difference (p < 0.05)\")\n",
        "        else:\n",
        "            print(f\"- No significant difference (p ≥ 0.05)\")\n",
        "            \n",
        "        if diff_mean > 0:\n",
        "            print(f\"- Low Income Designated CUs charge higher rates on average\")\n",
        "        else:\n",
        "            print(f\"- Low Income Designated CUs charge lower rates on average\")\n",
        "            \n",
        "        print(f\"- The practical significance is {effect_size.lower()} based on Cohen's d\")\n",
        "\n",
        "        print(f\"\\nOverall Rate Summary for Matched Loans:\")\n",
        "        print(f\"Low Income Designated CUs - Mean: {low_income_rates.mean():.3f}%, Median: {low_income_rates.median():.3f}%\")\n",
        "        print(f\"Non-Low Income Designated CUs - Mean: {non_low_income_rates.mean():.3f}%, Median: {non_low_income_rates.median():.3f}%\")\n",
        "\n",
        "    # LOAN AMOUNT vs INTEREST RATE RELATIONSHIP ANALYSIS\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"LOAN AMOUNT vs INTEREST RATE RELATIONSHIP ANALYSIS\")\n",
        "    print(\"=\"*60)\n",
        "    \n",
        "    # Correlation analysis\n",
        "    correlation = matched_loans[['loan_amount', 'interest_rate']].corr()\n",
        "    print(f\"\\nOverall correlation between loan amount and interest rate: {correlation.iloc[0,1]:.4f}\")\n",
        "    \n",
        "    # Separate correlations by credit union type\n",
        "    for cu_type in ['1', '0']:\n",
        "        cu_data = matched_loans[matched_loans['low_income_designation'] == cu_type]\n",
        "        cu_corr = cu_data[['loan_amount', 'interest_rate']].corr().iloc[0,1]\n",
        "        cu_label = 'Low Income Designated' if cu_type == '1' else 'Non-Low Income Designated'\n",
        "        print(f\"{cu_label} CUs correlation: {cu_corr:.4f}\")\n",
        "    \n",
        "    # Scatter plot: Loan Amount vs Interest Rate\n",
        "    plt.figure(figsize=(14, 8))\n",
        "    for cu_type, color, label in [('0', 'steelblue', 'Non-Low Income Designated'), \n",
        "                                   ('1', 'coral', 'Low Income Designated')]:\n",
        "        cu_data = matched_loans[matched_loans['low_income_designation'] == cu_type]\n",
        "        plt.scatter(cu_data['loan_amount'], cu_data['interest_rate'], \n",
        "                   alpha=0.6, color=color, label=label, s=20)\n",
        "    \n",
        "    plt.title('Loan Amount vs Interest Rate for Similar Loan Profiles', fontsize=14, fontweight='bold')\n",
        "    plt.xlabel('Loan Amount ($)', fontsize=12)\n",
        "    plt.ylabel('Interest Rate (%)', fontsize=12)\n",
        "    plt.legend(fontsize=11)\n",
        "    plt.grid(True, alpha=0.3)\n",
        "    plt.ticklabel_format(style='plain', axis='x')\n",
        "    plt.ylim(2, 8)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "    \n",
        "    # Binned analysis: Average rates by loan amount ranges\n",
        "    loan_bins = pd.cut(matched_loans['loan_amount'], \n",
        "                      bins=[0, 250000, 350000, 450000, 600000, float('inf')], \n",
        "                      labels=['<$250K', '$250K-350K', '$350K-450K', '$450K-600K', '>$600K'])\n",
        "    \n",
        "    binned_analysis = matched_loans.groupby([loan_bins, 'low_income_designation']).agg({\n",
        "        'interest_rate': ['count', 'mean', 'std'],\n",
        "        'applicant_income': 'mean',\n",
        "        'dti_numeric': 'mean'\n",
        "    }).round(3)\n",
        "    \n",
        "    binned_analysis.columns = ['count', 'avg_rate', 'std_rate', 'avg_income', 'avg_dti']\n",
        "    binned_analysis = binned_analysis.reset_index()\n",
        "    binned_analysis = binned_analysis[binned_analysis['count'] >= 5]\n",
        "    \n",
        "    print(f\"\\nAverage Interest Rates by Loan Amount Bins:\")\n",
        "    print(binned_analysis)\n",
        "    \n",
        "    # Visualization: Rates by loan amount bins\n",
        "    # Create labeled version for visualization\n",
        "    binned_viz = binned_analysis.copy()\n",
        "    binned_viz['cu_type_label'] = binned_viz['low_income_designation'].map({\n",
        "        '0': 'Non-Low Income Designated',\n",
        "        '1': 'Low Income Designated'\n",
        "    })\n",
        "    \n",
        "    plt.figure(figsize=(14, 7))\n",
        "    sns.barplot(x='loan_amount', y='avg_rate', hue='cu_type_label', \n",
        "                data=binned_viz, palette=['steelblue', 'coral'])\n",
        "    plt.title('Average Interest Rates by Loan Amount Range', fontsize=14, fontweight='bold')\n",
        "    plt.xlabel('Loan Amount Range', fontsize=12)\n",
        "    plt.ylabel('Average Interest Rate (%)', fontsize=12)\n",
        "    plt.legend(title='Credit Union Type', fontsize=11)\n",
        "    plt.xticks(rotation=45)\n",
        "    plt.ylim(2, 8)\n",
        "    plt.grid(True, alpha=0.3)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "    \n",
        "    # Rate spread analysis by loan size\n",
        "    rate_spreads = []\n",
        "    for loan_bin in binned_analysis['loan_amount'].unique():\n",
        "        bin_data = binned_analysis[binned_analysis['loan_amount'] == loan_bin]\n",
        "        if len(bin_data) == 2:  # Both CU types present\n",
        "            low_income_rate = bin_data[bin_data['low_income_designation'] == '1']['avg_rate'].iloc[0]\n",
        "            non_low_rate = bin_data[bin_data['low_income_designation'] == '0']['avg_rate'].iloc[0]\n",
        "            spread = low_income_rate - non_low_rate\n",
        "            rate_spreads.append({\n",
        "                'loan_bin': loan_bin,\n",
        "                'rate_spread': spread,\n",
        "                'low_income_rate': low_income_rate,\n",
        "                'non_low_rate': non_low_rate\n",
        "            })\n",
        "    \n",
        "    if rate_spreads:\n",
        "        spreads_df = pd.DataFrame(rate_spreads)\n",
        "        print(f\"\\nRate Spreads by Loan Amount (Low Income CU - Non-Low Income CU):\")\n",
        "        print(spreads_df)\n",
        "        \n",
        "        # Plot rate spreads\n",
        "        plt.figure(figsize=(12, 6))\n",
        "        colors = ['red' if x > 0 else 'green' for x in spreads_df['rate_spread']]\n",
        "        plt.bar(spreads_df['loan_bin'], spreads_df['rate_spread'], color=colors, alpha=0.7)\n",
        "        plt.title('Interest Rate Spread by Loan Amount Range\\n(Low Income CU Rate - Non-Low Income CU Rate)', \n",
        "                 fontsize=14, fontweight='bold')\n",
        "        plt.xlabel('Loan Amount Range', fontsize=12)\n",
        "        plt.ylabel('Rate Spread (percentage points)', fontsize=12)\n",
        "        plt.axhline(y=0, color='black', linestyle='-', alpha=0.5)\n",
        "        plt.xticks(rotation=45)\n",
        "        plt.grid(True, alpha=0.3)\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n",
        "        \n",
        "        print(f\"\\nKey Findings:\")\n",
        "        print(f\"- Average rate spread across loan sizes: {spreads_df['rate_spread'].mean():.3f} percentage points\")\n",
        "        print(f\"- Loan ranges where Low Income CUs charge more: {(spreads_df['rate_spread'] > 0).sum()}\")\n",
        "        print(f\"- Loan ranges where Low Income CUs charge less: {(spreads_df['rate_spread'] < 0).sum()}\")\n",
        "        print(f\"- Largest rate difference: {spreads_df['rate_spread'].abs().max():.3f} percentage points\")\n",
        "\n",
        "    # Also need to create a mapping for visualization labels\n",
        "    loans_df_viz = matched_loans.copy()\n",
        "    loans_df_viz['cu_type_label'] = loans_df_viz['low_income_designation'].map({\n",
        "        '0': 'Non-Low Income Designated',\n",
        "        '1': 'Low Income Designated'\n",
        "    })\n",
        "    \n",
        "    # Update the box plot to use labeled data\n",
        "    plt.figure(figsize=(12, 6))\n",
        "    sns.boxplot(x='cu_type_label', y='interest_rate', data=loans_df_viz, palette=['steelblue', 'coral'])\n",
        "    plt.title('Interest Rate Distribution for Similar Loan Profiles', fontsize=14, fontweight='bold')\n",
        "    plt.xlabel('Credit Union Type', fontsize=12)\n",
        "    plt.ylabel('Interest Rate (%)', fontsize=12)\n",
        "    plt.ylim(2, 8)\n",
        "    plt.grid(True, alpha=0.3)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "else:\n",
        "    print(\"No matched cohorts found with sufficient sample sizes.\")"
      ],
